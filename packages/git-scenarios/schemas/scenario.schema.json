{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScenarioSchema",
  "type": "object",
  "required": ["id", "title", "initialState", "goal", "success"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "initialState": {
      "type": "object",
      "properties": {
        "repositoryInitialized": { "type": "boolean" },
        "branch": { "type": "string" },
        "branches": { "type": "array", "items": { "type": "string" } },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "content"],
            "properties": {
              "path": { "type": "string" },
              "content": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        }
      }
    },
    "goal": { "type": "object" },
    "allowedCommands": { "type": "array", "items": { "type": "string" } },
    "hints": { "type": "array", "items": { "type": "string" } },
    "success": {
      "type": "object",
      "required": ["message", "xp"],
      "properties": {
        "message": { "type": "string" },
        "xp": { "type": "number" }
      }
    }
  }
}
