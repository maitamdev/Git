{
  "name": "git-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Nền tảng học Git & GitHub tương tác từ cơ bản đến nâng cao cho sinh viên Việt Nam",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "dev:api": "pnpm --filter @git-academy/api dev",
    "dev:web": "pnpm --filter playground dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "generate:courses": "tsx scripts/generate-courses.ts",
    "validate:courses": "tsx scripts/validate-courses.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:scenarios": "tsx scripts/validate-scenarios.ts",
    "audit:curriculum": "tsx scripts/audit-curriculum.ts",
    "audit:content": "tsx scripts/audit-content.ts",
    "lesson:new": "tsx scripts/lesson-new.ts",
    "scenario:new": "tsx scripts/scenario-new.ts",
    "export:scorm": "tsx scripts/export-scorm.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "seed:pilot": "tsx scripts/seed-pilot.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "verify:production-env": "tsx scripts/verify-production-env.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.7.0",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
