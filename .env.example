# ====================================================================
# Git Academy Vietnam — Sprint 6 Production Environment Configuration
# ====================================================================

# Environment
NODE_ENV=production

# Server Ports
PORT=3001
PLAYGROUND_PORT=3000
NGINX_PORT=80
NGINX_SSL_PORT=443

# PostgreSQL Database Configuration
DB_USER=gitacademy
DB_PASSWORD=change_this_to_strong_secret_password_in_production
DB_NAME=gitacademy_db
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://gitacademy:change_this_to_strong_secret_password_in_production@postgres:5432/gitacademy_db

# Security & Authentication
AUTH_SECRET=generate_with_openssl_rand_hex_32_characters_here
AUTH_TOKEN_EXPIRY=7d
CORS_ORIGIN=https://gitacademy.vn,http://localhost

# Admin One-Time Bootstrap (Run: pnpm bootstrap:admin)
ADMIN_BOOTSTRAP_EMAIL=admin@gitacademy.vn
ADMIN_BOOTSTRAP_PASSWORD=generate_a_very_strong_admin_password_min_8_chars
ADMIN_BOOTSTRAP_NAME=Quản Trị Viên Hệ Thống

# URLs
APP_URL=http://localhost
API_BASE_URL=http://localhost/api

# Moodle LMS Integration (Optional)
MOODLE_ENABLED=false
MOODLE_URL=http://moodle.university.edu.vn
MOODLE_WS_TOKEN=moodle_web_service_token_here
MOODLE_ROOT_PASSWORD=moodle_root_secret
MOODLE_DB_PASSWORD=moodle_user_secret
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=AdminPassword123!

# Observability & Logging
LOG_LEVEL=info
ENABLE_AUDIT_LOG=true
SENTRY_DSN=
